{
  "name": "tandem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,ws -c cyan,magenta \"next dev --hostname 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:ws": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:ws": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hocuspocus/extension-database": "^4.9.0",
    "@hocuspocus/provider": "^4.9.0",
    "@hocuspocus/server": "^4.9.0",
    "framer-motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "description": "Real-time collaborative workspace for the job hunt.",
  "engines": {
    "node": ">=22"
  }
}
