# Public websocket URL baked into the Next.js client at build time.
# Local default (used when this is unset): ws://127.0.0.1:1234
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:1234

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=1234

# SQLite file used when DATABASE_URL is unset.
DATABASE_PATH=./data/tandem.sqlite

# Optional. When set to a postgres URL, the websocket server stores Yjs
# snapshots in Postgres instead of SQLite. No paid service is required.
# DATABASE_URL=postgres://tandem:tandem@localhost:5432/tandem
